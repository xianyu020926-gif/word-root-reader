# 先用 :80 通过公网 IP 验证。绑定域名后改为 learn.example.com，Caddy 会自动申请 HTTPS。
APP_HOST=:80

# 多人账户与邀请注册。所有值只留在服务器，不提交到 GitHub。
APP_SESSION_SECRET=replace_with_at_least_32_random_characters
APP_INVITE_CODE=replace_with_a_private_invite_code
INITIAL_OWNER_USERNAME=owner
INITIAL_OWNER_PASSWORD=replace_with_a_strong_owner_password

# 密钥只保存在服务器上的 deploy/tencent-vps/.env，不提交到 GitHub。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
